# Save this file as .env next to gmo_trading_bot.py.
# Values in this file override OS environment variables.
DRY_RUN=true
SYMBOLS=BTC_JPY,ETH_JPY,BCH_JPY,LTC_JPY,XRP_JPY,DOT_JPY,ATOM_JPY,ADA_JPY,LINK_JPY,DOGE_JPY,SOL_JPY,SUI_JPY,MNT_JPY,BNB_JPY
# Five-field cron expression in Asia/Tokyo: minute hour day month weekday.
# The default evaluates all symbols at minute 0 of every hour.
TRADE_CRON=0 * * * *
KLINE_INTERVAL=15min
KLINE_COUNT=100
STRATEGY=HA_SMA
EMA_SHORT=9
EMA_LONG=20
SMA_SHORT=5
SMA_LONG=20
HA_BEARISH_EXIT_COUNT=2
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MAX_SPREAD_RATE=0.001
PRICE_TICK_JPY=1
SIZE_STEP=0.001
MIN_ORDER_SIZE=0.001
TARGET_ORDER_NOTIONAL_JPY=500
MIN_ORDER_NOTIONAL_JPY=500
MAX_ORDER_NOTIONAL_JPY=2000
MIN_REMAINING_BALANCE_JPY=3000
ABSOLUTE_LOSS_CUTOFF_JPY=50
LEVERAGE=2
PRICE_IMPROVEMENT_TICKS=1
TIME_IN_FORCE=FAS
MAKER_FEE_RATE=0
TAKER_FEE_RATE=0
ASSUMED_SLIPPAGE_RATE=0.0002
EDGE_MULTIPLIER=5
MIN_NET_PROFIT_RATE=0.0001
INITIAL_VIRTUAL_JPY=1000000
RISK_PER_TRADE_RATE=0.01
DAILY_LOSS_LIMIT_RATE=0.05
MAX_POSITION_RATE=0.10
STOP_DISTANCE_RATE=0.005
COOLDOWN_SECONDS=1200
REQUEST_TIMEOUT_SECONDS=10
GET_RETRIES=3
CANCEL_ON_EXIT=true
DATA_DIR=data
LOG_DIR=logs
GMO_API_KEY=
GMO_API_SECRET=
LIVE_TRADING_ACK=
